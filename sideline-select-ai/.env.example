# Copy to .env (same folder as this file). Real environment variables override these values.

# Where the database, thumbnails, previews and caches live. Never your photo folders.
# SIDELINE_DATA_DIR=~/SidelineSelect

# Extra folders the app may read photos from / export into (separate with ':' on macOS/Linux, ';' on Windows).
# By default: your home folder, removable-media mount points (/Volumes, /media, /mnt) and Windows drive letters.
# SIDELINE_ALLOWED_ROOTS=/Volumes/CardReader:/Users/me/Pictures

# Where model weights are looked up (default: backend/models)
# SIDELINE_MODELS_DIR=

# Port for the local server (it only listens on 127.0.0.1)
# SIDELINE_PORT=8000
