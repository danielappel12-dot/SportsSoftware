# Supabase project settings (Project Settings -> API).
# If either value is missing the app starts in clearly-labelled, read-only DEMO MODE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force demo mode even when Supabase is configured.
# NEXT_PUBLIC_DEMO_MODE=true

# Optional: public site URL used in auth e-mail redirects.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# NOTE: SponsorSync never needs the Supabase service-role key. Do not add it.
